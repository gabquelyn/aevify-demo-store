# Admit: copy to .env and fill in. Never commit .env.

# --- Aevify (from your Admit merchant account at https://aevify.vercel.app/dashboard) ---
AEVIFY_BASE_URL=https://aevify.vercel.app
AEVIFY_SECRET_KEY=sk_test_...          # Developers → Create secret key (server only)
AEVIFY_PUBLISHABLE_KEY=pk_test_...     # Developers → API keys
AEVIFY_WEBHOOK_SECRET=whsec_...        # Developers → Webhooks → Signing secret

# This store's public URL (payment success/cancel links). Optional on Vercel.
STORE_URL=http://localhost:3001

# --- Orders database (its own database; can be the same cluster as Aevify) ---
MONGODB_URI=mongodb://mongo:27017      # docker compose's local MongoDB; use your Atlas URI in production
MONGODB_DB=admit_tickets

# --- The AI agent customer (optional; testnet only) ---
# A wallet with some tUSD8 and tQDAY. Its key stays on the server.
AGENT_PRIVATE_KEY=
AGENT_MAX_PER_ORDER=10.00
AGENT_DAILY_BUDGET=25.00
AGENT_EXPECTED_CHAIN_ID=44005          # QDay Aevum Testnet
# AGENT_RPC_URL=https://rpc-test.qday.info

# --- Development ---
# STORE_TEST_MODE=memory               # keep orders in memory instead of MongoDB (never in production)
# ORDER_SYNC_AFTER_SECONDS=20          # ask Aevify directly if a webhook is this late
